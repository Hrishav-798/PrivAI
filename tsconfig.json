{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["chrome"]
  },
  "include": ["extension/src/**/*", "dashboard/src/**/*"],
  "exclude": ["node_modules", "**/node_modules/**", "dist", "**/dist/**", "**/*.test.ts", "**/*.test.tsx"]
}
