{
  "name": "privai-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build && cp -f dist/src/popup/popup.html dist/popup/popup.html && mkdir -p dist/offscreen && cp -f dist/src/offscreen/offscreen.html dist/offscreen/offscreen.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx src/benchmark/runBenchmark.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "onnxruntime-web": "^1.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
